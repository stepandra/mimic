{
  "type": "object",
  "additionalProperties": false,
  "required": ["class", "confidence", "evidence"],
  "properties": {
    "class": {"type": "string", "enum": ["TRIVIAL", "MINOR", "MAJOR", "BREAKING"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "start", "end"],
        "properties": {
          "artifact_id": {"type": "string"},
          "start": {"type": "integer"},
          "end": {"type": "integer"}
        }
      }
    }
  }
}
