/// Compile as a .gleam test with exact shared S4 + S5 + S6 snapshots.
/// Does not modify production codec ownership or imply assembled-ingress parity.
import gleam/erlang/process
import gleam/io
import gleam/option.{None, Some}
import gleeunit/should
import mimic/providers/contracts as c
import mimic/providers/xai/endpoint
import mimic/providers/xai_websocket as xai
import responses_tool_identity_test
import xai_adapter_test
import xai_argument_events_test
import xai_websocket_native_test

pub fn ws_argument_identity_is_validated_before_restoration_test() {
  let #(server, origin, _, closed) =
    xai_websocket_native_test.peer(None, "argument_identity")
  let context = c.Context("xai", "api_key", "synthetic-a", origin, "synthetic-session", c.ApiKey("synthetic-only"))
  let config = endpoint.Config(
    ..endpoint.defaults(endpoint.ApiKey),
    websockets: True,
    policy: endpoint.LocalMock,
  )
  let adapter = xai.selected_adapter("synthetic-tenant", config, None)
  let body = "{\"type\":\"response.create\",\"model\":\"grok-4.7\",\"input\":[],\"tools\":[{\"type\":\"namespace\",\"name\":\"shell\",\"tools\":[{\"type\":\"function\",\"name\":\"run\"}]},{\"type\":\"namespace\",\"name\":\"other\",\"tools\":[{\"type\":\"function\",\"name\":\"run\"}]}]}"
  let request = xai_websocket_native_test.req("api_key", body)
  let assert Ok(opened) = adapter.open(context, request)
  let assert Ok(handle) = adapter.send(opened.handle, request)
  let #(error, handle, delivered) = until_error(adapter, handle, 100, 0)
  error.delivery |> should.equal(c.Started)
  // created, keepalive, added survive. The conflicting argument-done does not.
  delivered |> should.equal(3)
  adapter.cancel(handle)
  process.receive(closed, 1000) |> should.be_ok
  process.unlink(server.pid)
  process.send_exit(server.pid)
}

fn until_error(adapter: c.SessionAdapter(xai.Handle), handle, attempts, delivered) {
  case adapter.receive(handle), attempts {
    Error(error), _ -> #(error, handle, delivered)
    Ok(#(None, next)), n if n > 0 -> until_error(adapter, next, n - 1, delivered)
    Ok(#(Some(_), next)), n if n > 0 ->
      until_error(adapter, next, n - 1, delivered + 1)
    _, _ -> panic as "synthetic conflicting tool identity was not rejected"
  }
}

pub fn main() {
  responses_tool_identity_test.supplied_tool_name_cannot_change_on_delta_or_done_test()
  responses_tool_identity_test.supplied_call_id_cannot_change_on_delta_or_done_test()
  responses_tool_identity_test.optional_identities_must_be_strings_if_present_test()
  responses_tool_identity_test.absent_or_matching_optional_identities_preserve_native_event_test()
  responses_tool_identity_test.item_id_and_function_custom_event_kind_checks_remain_enforced_test()
  responses_tool_identity_test.mismatched_name_sse_retains_valid_prefix_at_every_byte_split_test()
  xai_argument_events_test.named_argument_events_restore_only_identity_fields_test()
  xai_argument_events_test.unrelated_and_unnamed_events_are_not_rewritten_test()
  xai_adapter_test.selected_account_origin_and_tool_map_are_per_open_test()
  xai_websocket_native_test.physical_ws_wss_api_key_oauth_tools_continuation_test()
  ws_argument_identity_is_validated_before_restoration_test()
  io.println("{\"scope\":\"xai_v3_shared_s6_identity\",\"synthetic\":true,\"raw_identity_validation_before_restoration\":true,\"buffered_sse_ws_names_consistent\":true,\"argument_payload_unchanged\":true,\"conflicting_ws_argument_name_rejected\":true,\"assembled_ingress_exercised\":false,\"live_provider\":false}")
}
